<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="model"
            type="com.example.app21try6.database.models.PurchaseOrderModel" />
        <variable
            name="clickListener"
            type="com.example.app21try6.statement.purchaseorder.POModelListener" />
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="110dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Column positions: change the percents to widen/narrow gaps -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/col1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.03" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/col2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.30" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/col3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.55" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/col4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.78" />

            <TextView
                android:id="@+id/sub_name"
                style="@style/text_report_style"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:text="@{model.subName}"
                app:layout_constraintStart_toStartOf="@id/col1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Headers -->
            <TextView
                android:id="@+id/last30days"
                style="@style/text_report_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:text="30days"
                app:layout_constraintStart_toStartOf="@id/col1"
                app:layout_constraintTop_toBottomOf="@id/sub_name" />

            <TextView
                android:id="@+id/last90days"
                style="@style/text_report_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:text="90days"
                app:layout_constraintStart_toStartOf="@id/col2"
                app:layout_constraintTop_toBottomOf="@id/sub_name" />

            <TextView
                android:id="@+id/totalAvailableNet"
                style="@style/text_report_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:text="stok"
                app:layout_constraintStart_toStartOf="@id/col3"
                app:layout_constraintTop_toBottomOf="@id/sub_name" />

            <TextView
                android:id="@+id/purchaseOrder"
                style="@style/text_report_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:text="Order"
                app:layout_constraintStart_toStartOf="@id/col4"
                app:layout_constraintTop_toBottomOf="@id/sub_name" />

            <!-- Values -->
            <TextView
                android:id="@+id/last30days2"
                style="@style/text_report_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:text='@{String.format("%.2f", model.totalSells30Days)}'
                app:layout_constraintStart_toStartOf="@id/col1"
                app:layout_constraintTop_toBottomOf="@id/last30days" />

            <TextView
                android:id="@+id/last90days2"
                style="@style/text_report_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:text='@{String.format("%.2f", model.totalSells90Days)}'
                app:layout_constraintStart_toStartOf="@id/col2"
                app:layout_constraintTop_toBottomOf="@id/last30days" />

            <TextView
                android:id="@+id/totalAvailableNet2"
                style="@style/text_report_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:text='@{String.format("%.2f", model.totalNet)}'
                app:layout_constraintStart_toStartOf="@id/col3"
                app:layout_constraintTop_toBottomOf="@id/last30days" />

            <TextView
                android:id="@+id/purchaseOrder2"
                style="@style/text_report_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:text="@{String.valueOf(model.purcahseOrder)}"
                app:layout_constraintStart_toStartOf="@id/col4"
                app:layout_constraintTop_toBottomOf="@id/last30days" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</layout>