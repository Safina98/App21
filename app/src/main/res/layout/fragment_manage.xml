<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".statement.manage.ManageFragment"
        android:gravity="center"
        android:orientation="vertical">

        <Button
            android:layout_margin="@dimen/medium_margin"
            android:id="@+id/btn_category"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Kategori" />
        <Button
            android:layout_margin="@dimen/medium_margin"
            android:id="@+id/btn_expense_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Kategory Pengeluaran" />

        <Button
            android:layout_margin="@dimen/medium_margin"
            android:id="@+id/btn_suplier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Suplier" />
        <Button
            android:layout_margin="@dimen/medium_margin"
            android:id="@+id/btn_customer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Customer" />

        <Button
            android:layout_margin="@dimen/medium_margin"
            android:id="@+id/btn_diskon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Diskon" />


    </LinearLayout>
</layout>